# Copy to backend/.env (git-ignored) and fill in real values.

# Required. Generate with: openssl rand -hex 64
JWT_SECRET=

# Admin account created/updated on auth-service startup (password: min 12 chars)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Postgres credentials (must match the existing data volume)
POSTGRES_USER=streamx
POSTGRES_PASSWORD=streamx_password

# Optional SMTP for EMAIL notifications; without it email sends are recorded as FAILED
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=

# M-Pesa Daraja STK Push (subscriptions). Without these, checkout returns 503.
# Sandbox credentials: https://developer.safaricom.co.ke (sandbox shortcode 174379 + its test passkey)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# CustomerPayBillOnline for paybills, CustomerBuyGoodsOnline for till numbers
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Random secret appended to the callback URL. Generate with: openssl rand -hex 24
MPESA_CALLBACK_TOKEN=

# Optional tuning
# DB_POOL_SIZE=5
# MEDIA_TRANSCODE_THREADS=2
# MEDIA_MAX_UPLOAD=2GB
# ADMIN_API_URL=https://streamxapi.briankimathi.dev/api/v1
