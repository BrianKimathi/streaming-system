# Copy to backend/.env (git-ignored) and fill in real values.

# Required. Generate with: openssl rand -hex 64
JWT_SECRET=

# Admin account created/updated on auth-service startup (password: min 12 chars)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Postgres credentials (must match the existing data volume)
POSTGRES_USER=streamx
POSTGRES_PASSWORD=streamx_password

# Optional SMTP for EMAIL notifications; without it email sends are recorded as FAILED
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=

# MinIO object storage for videos, artwork and trailers. Generate the password with: openssl rand -hex 24
MINIO_ROOT_USER=streamx
MINIO_ROOT_PASSWORD=

# Encrypts M-Pesa credentials saved from the admin panel. Generate with: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=

# M-Pesa Daraja STK Push (subscriptions). Credentials saved in the admin panel (Settings > Payments) override these.
# Without either, checkout returns 503.
# Sandbox credentials: https://developer.safaricom.co.ke (sandbox shortcode 174379 + its test passkey)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# CustomerPayBillOnline for paybills, CustomerBuyGoodsOnline for till numbers
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Random secret appended to the callback URL. Generate with: openssl rand -hex 24
MPESA_CALLBACK_TOKEN=

# Optional tuning
# DB_POOL_SIZE=5
# MEDIA_TRANSCODE_THREADS=2
# MEDIA_MAX_VIDEO_BYTES=21474836480
# MEDIA_MAX_TRAILER_BYTES=2147483648
# MEDIA_MAX_IMAGE_BYTES=20971520
# ADMIN_API_URL=https://streamxapi.briankimathi.dev/api/v1
